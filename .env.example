# Copy to `.env` and fill in. `.env` is gitignored; THIS file is committed and
# must never contain a real secret — it is the contract, not the values.
#
# Keep every variable the app reads listed here, even the optional ones: this
# file is how a new machine (and every AI agent) learns what configuration
# exists without grepping the codebase.

# APP_ENV=development
# APP_URL=http://localhost:3000
# DATABASE_URL=
# API_KEY=
