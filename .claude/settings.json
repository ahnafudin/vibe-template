{
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "node scripts/bd-prime.mjs",
            "type": "command"
          }
        ],
        "matcher": ""
      }
